# CI/测试环境样例（key 集合与 .env.example 严格相等 —— L0.5 契约）
# CI 起服脚本负责注入真实端口；密码由 CI secret 注入，此处占位
E2E_NEXTJS_URL=http://localhost:5101
E2E_REACT_URL=http://localhost:5102
E2E_VUE_URL=http://localhost:5103
E2E_TEST_USERNAME=alice
E2E_TEST_PASSWORD=ci-injected
# 被测 saas-nextjs 实际连的库（globalSetup/teardown 种子 upsert 还原用；CI=saas_e2e scratch）
# 5.99（2026-09-23 人裁）：本机无本地 PG，家族库在 VPS——值=被测 5101 实连的 saas_dev
# （e2e-runtime.md §3.5 口径；CI 由 ci.yml 显式注入 saas_e2e scratch，不受本值影响）。
E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54321/saas_dev

# B 方案：登录 clientId（saas-console 自身应用）
E2E_TEST_CLIENT_ID=saas-console
